{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.gitero.ide",
  "version": "0.2.9-beta",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "storageLocation": "system",
  "dataLocation": "system",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*",
    "storage.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "Gitero IDE",
      "width": 1360,
      "height": 860,
      "minWidth": 720,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/icons/appIcon.png",
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "borderless": true,
      "transparent": true,
      "useLogicalPixels": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "gitero",
    "resourcesPath": "/dist/",
    "clientLibrary": "/dist/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
